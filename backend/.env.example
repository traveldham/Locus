APP_ENV=development
# Uses the current macOS/PostgreSQL user over the local Unix socket.
DATABASE_URL=postgresql+asyncpg:///locus
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Celery broker and result backend for background audit generation.
# Run a worker with: uv run celery -A app.worker worker --loglevel=info
REDIS_URL=redis://localhost:6379/0
# A snapshot read holds a second connection for its repeatable-read transaction.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Set true to run audit tasks inline instead of queueing them (tests, CI, no worker).
CELERY_ALWAYS_EAGER=false

# Directory holding the sample CSVs. Blank uses ../locus-intelligence-assignment/data.
# `uv run python -m app.seed` reads them to build the single demo account.
SAMPLE_DATA_DIR=

# A language model drafts suggestions for missing or weak profile fields.
# LLM_PROVIDER=vertex uses Vertex AI with your `gcloud auth application-default login`
# credentials; set VERTEX_PROJECT to your Google Cloud project. LLM_PROVIDER=gemini uses
# the Gemini Developer API with GEMINI_API_KEY. Leave the chosen provider unconfigured to
SUGGESTIONS_ENABLED=true
LLM_PROVIDER=vertex
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
