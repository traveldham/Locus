APP_ENV=development
# Uses the current macOS/PostgreSQL user over the local Unix socket.
DATABASE_URL=postgresql+asyncpg:///locus
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Directory holding the sample CSVs. Blank uses ../locus-intelligence-assignment/data.
# `uv run python -m app.seed` reads them to build the single demo account.
SAMPLE_DATA_DIR=
