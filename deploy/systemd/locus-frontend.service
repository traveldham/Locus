[Unit]
Description=Locus Next.js frontend
After=network.target locus-backend.service

[Service]
Type=simple
User=pawanpatrapp
Group=pawanpatrapp
WorkingDirectory=/home/pawanpatrapp/Locus/frontend
Environment=NODE_ENV=production
ExecStart=/home/pawanpatrapp/Locus/frontend/node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
